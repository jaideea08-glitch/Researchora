# Copy this file to .env.local and fill in your values.
# The current app uses Supabase for its free-tier database backend.
# If you want AI features later, add OPENAI_API_KEY as well.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: only needed if you wire in AI content or summaries later.
OPENAI_API_KEY=

# Optional: serve the app from a sub-path instead of the root, e.g. /researchora.
# Leave empty to serve it from the root.
NEXT_PUBLIC_BASE_PATH=

# If you want the app to connect from browser-side code as well, add these values too:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
